{
  "version": 2,
  "name": "samacharhub-api",
  "builds": [
    {
      "src": "dist/index.mjs",
      "use": "@vercel/node",
      "config": { "includeFiles": ["dist/**"] }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/index.mjs"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
